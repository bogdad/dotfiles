// Settings in here override those in "LSP/LSP.sublime-settings"
{	
	"lsp_format_on_save": true,
	"inhibit_snippet_completions": true,
	"inhibit_word_completions": true,
	"clients": {
		"rust-analyzer": {
			"command":["${home}/.cargo/bin/rust-analyzer"]
		},
		"clangd": {
			// first Homebrew llvm found (Apple Silicon or Intel); -j=1 on small CPUs
			"command":["sh", "-c", "for d in /opt/homebrew/opt/llvm /usr/local/opt/llvm; do [ -x $d/bin/clangd ] || continue; [ $(sysctl -n hw.ncpu) -le 4 ] && set -- -j=1 \"$@\"; exec $d/bin/clangd \"$@\"; done; exit 127", "clangd"],
			"initializationOptions": {
				"clangd.background-index": true,
				"clangd.header-insertion": "iwyu",
				"clangd.clang-tidy": true,
				"clangd.enable-config": true
			}
		}
	},
}
